		{
			"id": "branch4-text",
			"type": "text",
			"x": 60,
			"y": 560,
			"width": 260,
			"height": 130,
			"text": "TOO LOOSE PRE\n- Dấu hiệu: Đánh mọi bài (7-2/J-4),\nVPIP cực cao, \"bài nào cũng thắng\".\n- Trị: Size Preflop lớn (5-6x),\nPostflop tập trung Value cực chắc.",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"baseline": 18,
