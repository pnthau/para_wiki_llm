{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "hub",
      "type": "ellipse",
      "x": 400,
      "y": 280,
      "width": 200,
      "height": 100,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f1f3f5",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": { "type": 2 }
    },
    {
      "id": "hub_text",
      "type": "text",
      "x": 420,
      "y": 305,
      "width": 160,
      "height": 50,
      "text": "N5 ぶんぽう\n(７〜１２か)",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "te_zone",
      "type": "rectangle",
      "x": 30,
      "y": 30,
      "width": 320,
      "height": 220,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": { "type": 3 }
    },
    {
      "id": "te_header",
      "type": "text",
      "x": 45,
      "y": 45,
      "width": 290,
      "height": 25,
      "text": "🟥 〜て (THỂ TE)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#c92a2a"
    },
    {
      "id": "te_content",
      "type": "text",
      "x": 45,
      "y": 85,
      "width": 290,
      "height": 150,
      "text": "・〜てください (Hãy làm...)\n・〜てもいいです (Được phép)\n・〜てはいけません (Cấm)\n・〜ています (Đang làm/Trạng thái)\n\n💡 Ex: まどを しめてください",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "nai_zone",
      "type": "rectangle",
      "x": 650,
      "y": 30,
      "width": 320,
      "height": 220,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": { "type": 3 }
    },
    {
      "id": "nai_header",
      "type": "text",
      "x": 665,
      "y": 45,
      "width": 290,
      "height": 25,
      "text": "🟦 〜ない (THỂ NAI)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1971c2"
    },
    {
      "id": "nai_content",
      "type": "text",
      "x": 665,
      "y": 85,
      "width": 290,
      "height": 150,
      "text": "・〜なければなりません (Phải)\n・〜なくてもいいです (Ko cần)\n・〜ないでください (Đừng làm)\n・〜ないほうがいいです (Ko nên)\n\n💡 Ex: くすりを のまなければ...",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "ta_zone",
      "type": "rectangle",
      "x": 30,
      "y": 410,
      "width": 320,
      "height": 220,
      "strokeColor": "#e67700",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": { "type": 3 }
    },
    {
      "id": "ta_header",
      "type": "text",
      "x": 45,
      "y": 425,
      "width": 290,
      "height": 25,
      "text": "🟧 〜た (THỂ TA)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#e67700"
    },
    {
      "id": "ta_content",
      "type": "text",
      "x": 45,
      "y": 465,
      "width": 290,
      "height": 150,
      "text": "・〜たほうがいいです (Nên làm)\n・〜たことがあります (Đã từng)\n・〜たり 〜たりします (Liệt kê)\n\n💡 Ex: はやく ねたほうがいいです",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "masu_zone",
      "type": "rectangle",
      "x": 650,
      "y": 410,
      "width": 320,
      "height": 220,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#f4fce3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": { "type": 3 }
    },
    {
      "id": "masu_header",
      "type": "text",
      "x": 665,
      "y": 425,
      "width": 290,
      "height": 25,
      "text": "🟩 ます / その他 (MASU/KHÁC)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#2f9e44"
    },
    {
      "id": "masu_content",
      "type": "text",
      "x": 665,
      "y": 465,
      "width": 290,
      "height": 150,
      "text": "・〜ましょう (Cùng làm nhé)\n・〜たいです (Muốn làm...)\n・〜にいきます (Mục đích đi)\n・A は B より 〜 (So sánh hơn)\n\n💡 Ex: ビールを のみたいです",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "conn_te",
      "type": "arrow",
      "x": 400,
      "y": 300,
      "width": 50,
      "height": 50,
      "points": [[0, 0], [-50, -50]],
      "strokeColor": "#ced4da",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "endArrowhead": "arrow"
    },
    {
      "id": "conn_nai",
      "type": "arrow",
      "x": 600,
      "y": 300,
      "width": 50,
      "height": 50,
      "points": [[0, 0], [50, -50]],
      "strokeColor": "#ced4da",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "endArrowhead": "arrow"
    },
    {
      "id": "conn_ta",
      "type": "arrow",
      "x": 400,
      "y": 360,
      "width": 50,
      "height": 50,
      "points": [[0, 0], [-50, 50]],
      "strokeColor": "#ced4da",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "endArrowhead": "arrow"
    },
    {
      "id": "conn_masu",
      "type": "arrow",
      "x": 600,
      "y": 360,
      "width": 50,
      "height": 50,
      "points": [[0, 0], [50, 50]],
      "strokeColor": "#ced4da",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "endArrowhead": "arrow"
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": 20
  },
